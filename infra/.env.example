# =============================================================================
# MOF Enjaz Chatbot — local infra secrets template
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Generate random secrets with: openssl rand -hex <16|32>
# =============================================================================

DATA_ROOT=D:/MOF_Installations/volumes

# ---- Postgres (SPM project entity data) ---------------------------------
POSTGRES_SPM_USER=spm_admin
POSTGRES_SPM_PASSWORD=
POSTGRES_SPM_DB=spm_data
POSTGRES_SPM_PORT=5432

# Restricted role for the chat application (see migration 013): SELECT-only,
# row-level-security constrained to the session's project. The pipeline uses
# spm_admin instead. Every app transaction must SET LOCAL app.current_project.
POSTGRES_SPM_APP_USER=spm_app
POSTGRES_SPM_APP_PASSWORD=

# ---- Qdrant (vector DB) --------------------------------------------------
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Redis (app job queue: SharePoint ingest, OCR, embedding, scheduled scans) --
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- Langfuse v3 stack ----------------------------------------------------
LANGFUSE_WEB_PORT=3001
LANGFUSE_WORKER_PORT=3030

LANGFUSE_POSTGRES_USER=langfuse_admin
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_PORT=5433

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9004

LANGFUSE_REDIS_PASSWORD=

MINIO_ROOT_USER=langfuse_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# 64 hex chars (32 bytes) — openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# ---- Grafana LGTM (metrics + logs + traces, all-in-one) -------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---- Portainer --------------------------------------------------------
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ---- Langfuse client keys (for the app / workflow engine to send traces) --
# Generated via Langfuse UI: your org -> project -> Settings -> API Keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3001

# =============================================================================
# Cloud model providers — all Azure, TWO SEPARATE Azure accounts:
# one for the LLM, a different one for Embeddings + OCR.
# =============================================================================

# ---- LLM: Azure OpenAI gpt-5.4-mini (account #1) --
AZURE_OPENAI_LLM_ENDPOINT=
AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_API_VERSION=
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5.4-mini

# ---- Embeddings: Azure OpenAI embeddings (account #2) --
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- OCR: Azure AI Document Intelligence (separate from the LLM account) --
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# prebuilt-layout, not prebuilt-read — tables, structure and reading order
# all matter for chunking. SOLUTION_ARCHITECTURE.md 4.1.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# =============================================================================
# Ingestion pipeline
# =============================================================================

# Where the documents actually live. THIS is the setting that makes the
# solution dynamic rather than hardcoded to the demo corpus: repointing the
# pipeline at a real SharePoint export is a config change, not a code change.
# Stage 0 discovers documents by walking this tree — it never reads
# mock-data/spm_manifest.json, which only ever produced the seeded rows.
DOCUMENT_ROOT=D:\MOF_DataSample

# ---- Stage 0 (scanner) ----------------------------------------------------
# doc_type for a NEWLY discovered file. The filesystem genuinely cannot know
# what kind of document it is holding; classification belongs after OCR.
# Stage 0 never overwrites the doc_type of a row that already exists.
SCANNER_DEFAULT_DOC_TYPE=Unclassified
# Comma-separated globs, matched against every path component. A real
# SharePoint sync folder is not just documents: Word writes ~$name.docx lock
# files while a document is open, and Windows drops Thumbs.db/desktop.ini.
# Without this, Stage 1 would pay Document Intelligence to OCR a lock file.
SCANNER_IGNORE_PATTERNS=~$*,.*,Thumbs.db,desktop.ini

# ---- Stage 2 (chunking) — optional overrides ------------------------------
# Defaults live in pipeline/chunker.py and are used when these are unset.
# Tuned against real OCR output; expected to change once retrieval can
# actually be measured. SOLUTION_ARCHITECTURE.md 4.6.
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=120
CHUNK_SPLIT_HEADING_LEVEL=2
