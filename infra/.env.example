# =============================================================================
# MOF Enjaz Chatbot — local infra secrets template
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# Generate random secrets with: openssl rand -hex <16|32>
# =============================================================================

DATA_ROOT=D:/MOF_Installations/volumes

# ---- Postgres (SPM project entity data) ---------------------------------
# Host defaults to localhost for running the stages by hand. The worker
# container overrides it to the compose service name (see docker-compose.yml),
# which is why no module may read a hostname from code.
POSTGRES_SPM_HOST=localhost
POSTGRES_SPM_USER=spm_admin
POSTGRES_SPM_PASSWORD=
POSTGRES_SPM_DB=spm_data
POSTGRES_SPM_PORT=5432

# Restricted role for the chat application (see migration 013): SELECT-only,
# row-level-security constrained to the session's project. The pipeline uses
# spm_admin instead. Every app transaction must SET LOCAL app.current_project.
POSTGRES_SPM_APP_USER=spm_app
POSTGRES_SPM_APP_PASSWORD=

# ---- Qdrant (vector DB) --------------------------------------------------
# Derived from QDRANT_HTTP_PORT when unset. The worker container overrides it
# to http://qdrant:6333.
# QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Redis (Celery broker for the ingestion worker) ----------------------
# Overridden to the service name `redis` inside the compose network.
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- Langfuse v3 stack ----------------------------------------------------
LANGFUSE_WEB_PORT=3001
LANGFUSE_WORKER_PORT=3030

LANGFUSE_POSTGRES_USER=langfuse_admin
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_POSTGRES_PORT=5433

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9004

LANGFUSE_REDIS_PASSWORD=

MINIO_ROOT_USER=langfuse_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# 64 hex chars (32 bytes) — openssl rand -hex 32
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# ---- Grafana LGTM (metrics + logs + traces, all-in-one) -------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ---- Portainer --------------------------------------------------------
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# ---- Langfuse client keys (for the app / workflow engine to send traces) --
# Generated via Langfuse UI: your org -> project -> Settings -> API Keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# The UI lives at LANGFUSE_NEXTAUTH_URL; traces are sent to
# LANGFUSE_OTLP_ENDPOINT below. There is no third base URL to set.

# ---- Tracing (observability/tracing.py) -----------------------------------
# ONE instrumentation, TWO backends. Langfuse v3 exposes an OTLP endpoint,
# so LLM tracing needs no second SDK -- the same spans go to Grafana (where
# did the time go) and Langfuse (what was the model actually asked).
#
# Off by default: tracing is an operator's choice, and a developer running
# the test suite should not need a collector.
OBSERVABILITY_ENABLED=false
OTEL_SERVICE_NAME=enjaz-chat
OTEL_ENVIRONMENT=dev

OTLP_TRACING_ENABLED=true
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

LANGFUSE_TRACING_ENABLED=true
LANGFUSE_OTLP_ENDPOINT=http://localhost:3001/api/public/otel/v1/traces

# WARNING: `true` sends prompts and completions -- which contain project
# document passages -- into the trace store. A trace store has no notion of
# AC09: anyone who can read Langfuse can read every project's passages,
# regardless of assignment. Acceptable here only because Langfuse is a
# container on the same machine holding the same corpus. Set to `false`
# against any shared or hosted trace store; timing and token counts, which
# are most of the operational value, are unaffected.
LANGFUSE_CAPTURE_CONTENT=true

OTEL_EXPORT_TIMEOUT_SECONDS=5

# =============================================================================
# Cloud model providers — all Azure.
#
# These were TWO separate accounts until 2026-09-07, when account #1's key
# stopped authenticating and gpt-5.4-mini was redeployed onto account #2's
# resource. All three roles now share one resource and one key, so the LLM
# and EMBEDDING endpoint/key pairs below are currently identical. They are
# kept as separate variables on purpose: config.py groups model settings by
# ROLE, not by account, which is what made moving one role a two-line
# change here rather than a code change.
# =============================================================================

# ---- LLM: Azure OpenAI gpt-5.4-mini (account #2 since 2026-09-07) --
AZURE_OPENAI_LLM_ENDPOINT=
AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_API_VERSION=
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5.4-mini

# ---- Embeddings: Azure OpenAI embeddings (account #2) --
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---- OCR: Azure AI Document Intelligence (separate from the LLM account) --
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# prebuilt-layout, not prebuilt-read — tables, structure and reading order
# all matter for chunking. SOLUTION_ARCHITECTURE.md 4.1.
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout

# =============================================================================
# Ingestion pipeline
# =============================================================================

# Where the documents actually live. THIS is the setting that makes the
# solution dynamic rather than hardcoded to the demo corpus: repointing the
# pipeline at a real SharePoint export is a config change, not a code change.
# Stage 0 discovers documents by walking this tree — it never reads
# mock-data/spm_manifest.json, which only ever produced the seeded rows.
DOCUMENT_ROOT=D:\MOF_DataSample

# ---- Stage 0 (scanner) ----------------------------------------------------
# doc_type for a NEWLY discovered file. The filesystem genuinely cannot know
# what kind of document it is holding; classification belongs after OCR.
# Stage 0 never overwrites the doc_type of a row that already exists.
SCANNER_DEFAULT_DOC_TYPE=Unclassified
# Comma-separated globs, matched against every path component. A real
# SharePoint sync folder is not just documents: Word writes ~$name.docx lock
# files while a document is open, and Windows drops Thumbs.db/desktop.ini.
# Without this, Stage 1 would pay Document Intelligence to OCR a lock file.
SCANNER_IGNORE_PATTERNS=~$*,.*,Thumbs.db,desktop.ini

# ---- Stage 1 (OCR) — optional overrides -----------------------------------
# Below this many characters a result is FLAGGED in the run summary, never
# failed: a scan whose content lives inside images can never improve, and
# marking it failed would re-bill it on every future run.
OCR_THIN_RESULT_CHARS=200
# Retry documents already marked failed. Default false — a genuinely broken
# file must not silently re-bill per page on every run. `--retry-failed`
# overrides per run.
OCR_RETRY_FAILED=false
# Flags (never truncates) a provider response larger than this. Measured on
# the demo corpus: 177 kB average, 1.3 MB largest — roughly 65 kB per page.
OCR_RAW_RESPONSE_WARN_BYTES=5000000

# ---- Stages 2+3 (embed + index) — optional overrides ----------------------
# Embedding requests are capped two ways at once, because either limit can
# bite first: chunks per request, and their combined token count.
INDEX_BATCH_SIZE=32
INDEX_MAX_BATCH_TOKENS=16000
# Deliberately the OPPOSITE default to OCR_RETRY_FAILED. Re-embedding the
# whole corpus costs under a cent, so hiding failures serves nobody.
INDEX_RETRY_FAILED=true

# ---- Stage 2 (chunking) — optional overrides ------------------------------
# Defaults live in pipeline/chunker.py and are used when these are unset.
# Tuned against real OCR output; expected to change once retrieval can
# actually be measured. SOLUTION_ARCHITECTURE.md 4.6.
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=120
CHUNK_SPLIT_HEADING_LEVEL=2

# ---- Ingestion worker (Celery) --------------------------------------------
# Host path bind-mounted read-only into the worker at /data. Inside the
# container DOCUMENT_ROOT is /data (set in docker-compose.yml), so identical
# code runs on the host and in the container.
DOCUMENT_ROOT_HOST=D:/MOF_DataSample
# Broker/backend are derived from REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
# unless set explicitly. Compose overrides REDIS_HOST to the service name.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# Stops a scheduled run overlapping the previous one. Must exceed the
# longest plausible run — full-corpus OCR took ~5 minutes.
CELERY_LOCK_TIMEOUT=3600
# When the daily full ingest fires. A wall-clock TIME, not an interval —
# an interval drifts against the clock every time beat restarts.
INGEST_SCHEDULE_HOUR=13
INGEST_SCHEDULE_MINUTE=0
# ⚠️ The timezone is part of the schedule, not decoration. Containers run on
# UTC, so hour=13 alone fires at 16:00 in a UTC+3 deployment — three hours
# from what "1 PM" meant. A named zone also handles daylight saving, which a
# fixed offset would not.
INGEST_SCHEDULE_TIMEZONE=Asia/Amman

# ---- Retrieval evaluation — optional overrides ----------------------------
# The question set is DATA, not code: a path, so a different corpus brings
# its own file and no module changes. Defaults to evaluation/questions.json
# in the repo. See evaluation/ and STATUS_AND_ROADMAP.md 13b.
# EVAL_QUESTIONS_PATH=
# Recall cut-offs reported. Search depth follows from the deepest of these,
# so a depth shallower than the deepest cut-off cannot silently under-report.
# EVAL_RECALL_AT=1,3,5

# ---- Chat application (Application/) — optional overrides -----------------
# Connection pool behind the SELECT-only, RLS-constrained `spm_app` role.
# The ingestion pipeline uses none of this: it opens one connection per run.
# Pooling is where SET LOCAL stops being a style preference and becomes the
# isolation boundary — a plain SET persists onto whoever borrows the
# connection next. See INFRASTRUCTURE.md 7c.
# APP_POOL_MIN_SIZE=1
# APP_POOL_MAX_SIZE=8
# A request that waits forever for a connection has already blown the AC08
# five-second budget, so waiting is bounded and then fails.
# APP_POOL_TIMEOUT_SECONDS=10

# ---- Grounded answering (Application/backend/answer.py) -------------------
# How many passages are retrieved, and the ceiling on what is actually SENT.
# They bound different things: retrieving more is free, sending more costs
# tokens and seconds against the AC08 five-second budget.
# ANSWER_TOP_K=8
# ANSWER_MAX_CONTEXT_TOKENS=6000
# ANSWER_MAX_COMPLETION_TOKENS=2000
# Deterministic by default — a grounded assistant should not paraphrase the
# same evidence differently on each run.
# ANSWER_TEMPERATURE=0
# Below this similarity the LLM is not called at all: a question whose best
# match is noise gets an honest "not in the documents" rather than a paid
# call inviting the model to improvise. Measured range on this corpus is
# roughly 0.31–0.56.
# ANSWER_MIN_SCORE=0.25
# A hard ceiling, not a target. Stops an abnormal request hanging; tightening
# it toward the AC08 budget belongs with the real latency work.
# ANSWER_TIMEOUT_SECONDS=20

# ---- HTTP layer (Application/backend/api/) --------------------------------
# API_HOST=127.0.0.1
# API_PORT=8000
# ⚠️ auth_mode is the AC09 boundary: the gate answers "may this user open
# this project?", never "is this really that user?", so whatever establishes
# the username becomes part of that guarantee.
#   session_login — the demo: seeded email + password, signed session cookie
#   dev_fixed     — every request is API_DEV_USERNAME. Local development only
#   header        — trusts API_AUTH_HEADER, for a gateway that has already
#                   authenticated. NEVER expose that port directly
# API_AUTH_MODE=session_login
# API_AUTH_HEADER=X-Enjaz-User
# API_DEV_USERNAME=
# Required when API_AUTH_MODE=session_login. Signs the session cookie, so
# rotating it invalidates every live session — which is the intended way to
# sign everyone out. Generate with: openssl rand -hex 32
API_SESSION_SECRET=
# API_SESSION_HOURS=8
# Set true wherever the app is served over HTTPS, so the cookie is never
# sent in the clear. Left false only because the demo runs on plain http.
# API_COOKIE_SECURE=false

# Where conversations live between turns.
#   redis  — survives a restart and is shared across workers
#   memory — single process, lost on restart; fine for a laptop demo
# ⚠️ Whatever the store, the project code in a restored conversation is a
# CLAIM, not a permission: every read re-runs the AC09 gate.
# API_CONVERSATION_STORE=redis
# API_CONVERSATION_IDLE_MINUTES=120
# API_MAX_CONVERSATIONS=500
# API_MAX_QUESTION_CHARS=2000

# A cost guard, not a boundary — keyed on the authenticated username so one
# busy person cannot throttle a building behind a shared NAT. 0 means no
# limit. ⚠️ Fails OPEN if Redis is unreachable: a limiter outage must not
# become a service outage. The AC09 checks around it fail closed.
# API_RATE_LIMIT_QUESTIONS=30
# API_RATE_LIMIT_WINDOW_SECONDS=60

# Empty means same-origin only, which is what the demo serves.
# API_CORS_ORIGINS=

# ---- Conversation memory (Application/backend/conversation.py) ------------
# How much of the exchange is replayed to the model. Bounded twice: turns
# are what a follow-up plausibly refers back to, tokens are what the AC08
# budget can afford.
# CONVERSATION_MAX_HISTORY_TURNS=6
# CONVERSATION_MAX_HISTORY_TOKENS=1500
# When a follow-up retrieves nothing above the floor, retry once with the
# question rewritten against the history — "وتاريخ الانتهاء؟" alone matches
# nothing until it carries its subject.
# CONVERSATION_RETRY_BELOW_FLOOR=true

# ---- Document classification (pipeline/classify.py, Stage 1b) -------------
# The label vocabulary, held as DATA: a different deployment brings its own.
# The model may only answer with a label from this file, and an unconfident
# answer is recorded as Unclassified rather than guessed.
# DOC_TYPE_LABELS_PATH=pipeline/doc_type_labels.json

# ---- OCR transient retries (pipeline/ocr.py) ------------------------------
# A throttled or briefly unavailable Azure endpoint is not a failed document.
# Retries apply only to transient errors; a rejected file fails immediately
# rather than being billed three times to fail the same way.
# OCR_TRANSIENT_RETRIES=2
# OCR_TRANSIENT_BACKOFF_SECONDS=2.0
