# The build context is the repository root, so without this the whole
# .venv (hundreds of MB) is uploaded to the daemon on every build — slow,
# and pointless since dependencies are installed from requirements.txt
# inside the image.
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets never belong in an image layer. Both containers receive their
# configuration from Compose (env_file + environment) at run time.
infra/.env

.git/
.github/
.claude/

# Not needed to run the pipeline or the chat app.
Documentation/
My_Prompts/
tests/
mock-data/
Tools ACC/
*.md
